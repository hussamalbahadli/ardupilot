# hw definition file for processing by chibios_hwdef.py for Ashura 1

# MCU class and specific type
MCU STM32H7xx STM32H743xx

# crystal frequency
OSCILLATOR_HZ 16000000

# board ID for firmware load
APJ_BOARD_ID 1500

FLASH_SIZE_KB 2048

# with 2M flash we can afford to optimize for speed
env OPTIMIZE -O2

# ChibiOS system timer
STM32_ST_USE_TIMER 2

# bootloader takes first sector
FLASH_RESERVE_START_KB 128

# order of UARTs (and USB)
SERIAL_ORDER OTG1 USART1 USART2 USART3 UART4 USART6 UART7 UART8 OTG2

# default the 2nd interface to MAVLink2 until MissionPlanner updates drivers
define HAL_OTG2_PROTOCOL SerialProtocol_MAVLink2

# define the pins that USB is connected on
PA11 OTG_FS_DM OTG1
PA12 OTG_FS_DP OTG1

# three pins for SWD debugging with a STlinkv2 or black-magic probe
PA13 JTMS-SWDIO SWD
PA14 JTCK-SWCLK SWD

# SPI1 - BMI088 IMU 
PG11 SPI1_SCK SPI1
PG9 SPI1_MISO SPI1
PD7 SPI1_MOSI SPI1

# SPI2 - ICM42688 IMU
PI1 SPI2_SCK SPI2
PI2 SPI2_MISO SPI2
PI3 SPI2_MOSI SPI2

# SPI3 - RM3100 Compass
PB3 SPI3_SCK SPI3
PB4 SPI3_MISO SPI3
PB5 SPI3_MOSI SPI3

# SPI4 - MS5611 Barometer
PE2 SPI4_SCK SPI4
PE5 SPI4_MISO SPI4
PE6 SPI4_MOSI SPI4

# SPI5 - MS4525DO_SS3AS015AP 
PF7 SPI5_SCK SPI5
PF8 SPI5_MISO SPI5
PF9 SPI5_MOSI SPI5

# SPI6 - FRAM
PA5 SPI6_SCK SPI6
PA6 SPI6_MISO SPI6
PG14 SPI6_MOSI SPI6

# sensor chip select pins
PA3  BMI088_A_CS CS
PE10 BMI088_G_CS CS
PE12 ICM42688_CS CS
PF1 MS4525DO_SS3AS015AP_CS CS
PE15 MS5611_CS CS
PH7 FLASH_CS CS SPEED_VERYLOW

# I2C buses

# I2C1 - internal sensors BMI088
PB8 I2C1_SCL I2C1
PB9 I2C1_SDA I2C1

# I2C2 - internal sensors MS4525DO_DS5AI001DP
PH4 I2C2_SCL I2C2
PH5 I2C2_SDA I2C2

# I2C3 - internal EEPROM FRAM
PA8 I2C3_SCL I2C3
PH8 I2C3_SDA I2C3

# I2C4 - external sensors
PF14 I2C4_SCL I2C4
PF15 I2C4_SDA I2C4

# order of I2C buses
I2C_ORDER I2C1 I2C2 I2C3 I2C4

define HAL_I2C_INTERNAL_MASK 1

# define enable pin
PI4 VDD_3V3_SENSOR_EN OUTPUT LOW

# DRDY pins for sensors
PG0 DRDY1_BMI088_A1 INPUT 
PG1 DRDY2_BMI088_G1 INPUT
PC3 DRDY3_BMI088_A2 INPUT
PF10 DRDY4_BMI088_G2 INPUT
PC2 DRDY5_BMI088_A3 INPUT
PF5 DRDY6_BMI088_G3 INPUT
PI10 DRDY7_BMI088_A4 INPUT
PF6 DRDY8_BMI088_G4 INPUT
PB12 DRDY9_ICM42688_1 INPUT
PB13 DRDY10_ICM42688_2 INPUT
PG10 DRDY11_RM3100 INPUT

# UARTs 

# USART1 is Spear 
PB14 USART1_TX USART1 NODMA
PA10 USART1_RX USART1 NODMA

# USART2 is TElEMETRY1
PD5 USART2_TX USART2 
PD6 USART2_RX USART2
PD3 USART2_CTS USART2
PD4 USART2_RTS USART2

# USART3 is Spare
PD8 USART3_TX USART3 NODMA
PD9 USART3_RX USART3 NODMA

# UART4 is GPS
PD0 UART4_RX UART4 NODMA
PD1 UART4_TX UART4 NODMA

# USART6 is Telemetry2
PC6 USART6_TX USART6
PC7 USART6_RX USART6
PG15 USART6_CTS USART6
PG8 USART6_RTS USART6

# UART7 is Debug
PE7 UART7_RX UART7 NODMA
PE8 UART7_TX UART7 NODMA

# UART8 is Sbus
PE0 UART8_RX UART8  
PE1 UART8_TX UART8

# PWM 
PH10 TIM5_CH1 TIM5 PWM(1) GPIO(127)
PH11 TIM5_CH2 TIM5 PWM(2) GPIO(126)
PH12 TIM5_CH3 TIM5 PWM(3) GPIO(123)
PI0  TIM5_CH4 TIM5 PWM(4) GPIO(122)
PD12 TIM4_CH1 TIM4 PWM(5) GPIO(121)
PD13 TIM4_CH2 TIM4 PWM(6) GPIO(120)
PD14 TIM4_CH3 TIM4 PWM(7) GPIO(117)
PD15 TIM4_CH4 TIM4 PWM(8) GPIO(116)

# AUX PWM outputs
PB15 TIM12_CH2 TIM12 PWM(9) GPIO(63) NODMA
PE11 TIM1_CH2 TIM1   PWM(10) GPIO(100)
PE13 TIM1_CH3 TIM1   PWM(11) GPIO(99)
PE14 TIM1_CH4 TIM1   PWM(12) GPIO(96)
PH6 TIM12_CH1 TIM12 PWM(13) GPIO(62) NODMA
PE9 TIM1_CH1 TIM1 PWM(14) GPIO(102) 

# allow for 14 PWMs by default


# alarm buzzer not connected to a timer, so just use a GPIO
PB10 BUZZER OUTPUT LOW

# ANALOG inputs
PB0 BATT_VOLTAGE_SENS ADC1 SCALE(1)

PA4 SPARE1_ADC1 ADC1 SCALE(1)
PC0 SPARE2_ADC1 ADC1 SCALE(1)

PA0 RSSI_IN ADC1 SCALE(1)

PF11 VDD_5V_SENS ADC1 SCALE(2)
PF12 SCALED_V3V3 ADC1 SCALE(2)

# CAN Bus
PH13 CAN1_TX CAN1
PH14 CAN1_RX CAN1

PB6 CAN2_TX CAN2
PB5 CAN2_RX CAN2

# GPIOs FOR HEATER

PH3 HEATER_EN OUTPUT LOW (80)
define HAL_HEATER_GPIO_PIN 80
define HAL_HAVE_IMU_HEATER 1

# SPI 





